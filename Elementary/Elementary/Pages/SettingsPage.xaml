<Page
    x:Class="Elementary.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Elementary"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d"
    Background="Transparent"
    Tag="Settings">

    <Page.Resources>
        <!--  These styles can be referenced to create a consistent SettingsPage layout  -->

        <!--  Spacing between cards  -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <!--  Style (inc. the correct spacing) of a section header  -->
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <Grid Padding="16">
                <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">
                    <!--<win:StackPanel.ChildrenTransitions>
                        <win:EntranceThemeTransition FromVerticalOffset="50" />
                        <win:RepositionThemeTransition IsStaggeringEnabled="False" />
                    </win:StackPanel.ChildrenTransitions>-->
                    

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="Reading" />
                    <controls:SettingsCard Description="The translation of the Bible you would like to use"
                                       Header="Translation"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE736;}">
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem>NET</ComboBoxItem>
                            <ComboBoxItem>ASV</ComboBoxItem>
                            <ComboBoxItem>KJV</ComboBoxItem>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Choose whether to show verse numbers inline"
                                           Header="Show verse numbers"
                                           HeaderIcon="{ui:FontIcon Glyph=&#xE8A4;}"
                                           IsEnabled="False">
                        <ToggleSwitch IsOn="True" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Set the color scheme you prefer"
                                           Header="Theme"
                                           HeaderIcon="{ui:FontIcon Glyph=&#xE771;}"
                                           IsEnabled="False">
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem>System</ComboBoxItem>
                            <ComboBoxItem>Light</ComboBoxItem>
                            <ComboBoxItem>Dark</ComboBoxItem>
                        </ComboBox>
                    </controls:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Acknowledgements" />
                    <controls:SettingsExpander Description="Acknowledgements for the NET Bible"
                                               Header="NET Bible"
                                               HeaderIcon="{ui:FontIcon Glyph=&#xE716;}">
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard>
                                <controls:SettingsCard.Resources>
                                    <x:Double x:Key="SettingsCardWrapThreshold">300</x:Double>
                                    <x:Double x:Key="SettingsCardWrapNoIconThreshold">300</x:Double>
                                </controls:SettingsCard.Resources>

                                <TextBlock TextWrapping="WrapWholeWords">Scripture quoted by permission. Quotations designated (NET) are from the NET Bible® copyright ©1996, 2019 by Biblical Studies Press, L.L.C. http://netbible.com All rights reserved.</TextBlock>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="About" />

                    <controls:SettingsExpander Description="© 2024. All rights reserved."
                                           Header="About Elementary"
                                           HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/logo.png}">
                        <TextBlock x:Name="VersionTextBlock"
                                   win:IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard ContentAlignment="Left">
                                <TextBlock>👨🏻‍👩🏻‍👧🏻‍👦🏻 Hello from Marietta</TextBlock>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <HyperlinkButton Margin="0,8,0,0"
                                 Content="Send feedback" NavigateUri="mailto:ezra.ward@outlook.com"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
