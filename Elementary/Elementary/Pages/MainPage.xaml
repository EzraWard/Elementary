<Page
    x:Class="Elementary.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Elementary"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="32"/>
            <RowDefinition x:Name="ContentRow" Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitlebarGrid"  Height="32" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Spacing="8">
                <Image Height="18" Source="ms-appx:///Assets/logo.png" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center">Elementary</TextBlock>
            </StackPanel>
        </Grid>
        <muxc:NavigationView Name="MainNavigationView" ItemInvoked="NavigationView_ItemInvoked" Grid.Row="1" IsTitleBarAutoPaddingEnabled="false" IsBackButtonVisible="Collapsed" IsPaneOpen="False">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="BiblePageNavigationViewItem" Content="Bible" Tag="BiblePage">
                    <muxc:NavigationViewItem.Icon>
                        <!--Including the font file for Segoe Fluent Icons in project ensures that the font properly displays on Windows 10-->
                        <FontIcon FontFamily="/Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE736;"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="VerseOfTheDayNavigationViewItem" Content="Verse of the Day" Tag="VerseOfTheDay">
                    <muxc:NavigationViewItem.Icon>
                        <!--Including the font file for Segoe Fluent Icons in project ensures that the font properly displays on Windows 10-->
                        <FontIcon FontFamily="/Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE787;"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>
            <Frame Name="ContentFrame" NavigationFailed="ContentFrame_NavigationFailed" />
        </muxc:NavigationView>
    </Grid>
</Page>
