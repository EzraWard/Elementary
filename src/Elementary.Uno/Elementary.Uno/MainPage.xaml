<Page x:Class="Elementary.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Dark"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="ReaderSurfaceColor">#F3F3F3</Color>
          <Color x:Key="ReaderTransparentColor">#00F3F3F3</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="ReaderSurfaceColor">#202020</Color>
          <Color x:Key="ReaderTransparentColor">#00202020</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Page.Resources>
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The compact title strip mirrors the native app's Windows title bar. -->
    <Grid Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16,0">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/TitleBarIcon.png" Width="16" Height="16" />
        <TextBlock Text="Elementary" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <NavigationView x:Name="MainNavigationView" Grid.Row="1" IsPaneOpen="False" PaneDisplayMode="LeftCompact"
                    CompactPaneLength="48" OpenPaneLength="260" IsBackButtonVisible="Collapsed"
                    IsTitleBarAutoPaddingEnabled="False" ItemInvoked="NavigationView_ItemInvoked">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="BibleNavigationItem" Content="Bible" Tag="Bible">
          <NavigationViewItem.Icon><!-- Exact E736 outline from the UWP Segoe Fluent Icons asset; stable before font loading. --><PathIcon Width="20" Height="20" Data="M18.75 4.375L18.75 15.625Q18.75 16.00586 18.6035 16.34766Q18.457 16.68945 18.1982 16.94824Q17.9395 17.20703 17.5977 17.35352Q17.2559 17.5 16.875 17.5L1.875 17.5Q1.49414 17.5 1.15234 17.35352Q0.810547 17.20703 0.551758 16.94824Q0.292969 16.68945 0.146484 16.34766Q0 16.00586 0 15.625L0 4.375Q0 3.9941 0.146484 3.6523Q0.292969 3.3105 0.551758 3.0518Q0.810547 2.793 1.15234 2.6465Q1.49414 2.5 1.875 2.5L2.5 2.5L2.5 1.875Q2.5 1.4941 2.64648 1.1523Q2.79297 0.8105 3.05176 0.5518Q3.31055 0.293 3.65234 0.1465Q3.99414 0 4.375 0L6.875 0Q7.58789 0 8.26172 0.3027Q8.93555 0.6055 9.375 1.1719Q9.81445 0.6055 10.4883 0.3027Q11.1621 0 11.875 0L14.375 0Q14.7559 0 15.0977 0.1465Q15.4395 0.293 15.6982 0.5518Q15.957 0.8105 16.1035 1.1523Q16.25 1.4941 16.25 1.875L16.25 2.5L16.875 2.5Q17.2559 2.5 17.5977 2.6465Q17.9395 2.793 18.1982 3.0518Q18.457 3.3105 18.6035 3.6523Q18.75 3.9941 18.75 4.375ZM3.75 13.125Q3.75 13.37891 3.93555 13.56445Q4.12109 13.75 4.375 13.75L6.875 13.75Q7.37305 13.75 7.84668 13.85254Q8.32031 13.95508 8.75 14.19922L8.75 3.125Q8.75 2.7051 8.61816 2.3633Q8.48633 2.0215 8.2373 1.7725Q7.98828 1.5234 7.6416 1.3867Q7.29492 1.25 6.875 1.25L4.375 1.25Q4.12109 1.25 3.93555 1.4355Q3.75 1.6211 3.75 1.875L3.75 13.125ZM11.875 1.25Q11.4453 1.25 11.1035 1.3867Q10.7617 1.5234 10.5127 1.7676Q10.2637 2.0117 10.1318 2.3584Q10 2.7051 10 3.125L10 14.19922Q10.4297 13.95508 10.9033 13.85254Q11.377 13.75 11.875 13.75L14.375 13.75Q14.6289 13.75 14.8145 13.56445Q15 13.37891 15 13.125L15 1.875Q15 1.6211 14.8145 1.4355Q14.6289 1.25 14.375 1.25L11.875 1.25ZM17.5 4.375Q17.5 4.1602 17.417 4.0381Q17.334 3.916 17.2021 3.8525Q17.0703 3.7891 16.9092 3.7695Q16.748 3.75 16.582 3.75L16.25 3.75L16.25 13.125Q16.25 13.50586 16.1035 13.84766Q15.957 14.18945 15.6982 14.44824Q15.4395 14.70703 15.0977 14.85352Q14.7559 15 14.375 15L11.875 15Q11.6309 15 11.3477 15.04883Q11.0645 15.09766 10.791 15.20508Q10.5176 15.3125 10.293 15.47852Q10.0684 15.64453 9.95117 15.87891Q9.90234 15.97656 9.84375 16.03516Q9.73633 16.14258 9.63379 16.19629Q9.53125 16.25 9.375 16.25Q9.21875 16.25 9.11621 16.19629Q9.01367 16.14258 8.90625 16.03516Q8.84766 15.97656 8.79883 15.87891Q8.68164 15.64453 8.45703 15.47852Q8.23242 15.3125 7.95898 15.20508Q7.68555 15.09766 7.40234 15.04883Q7.11914 15 6.875 15L4.375 15Q3.99414 15 3.65234 14.85352Q3.31055 14.70703 3.05176 14.44824Q2.79297 14.18945 2.64648 13.84766Q2.5 13.50586 2.5 13.125L2.5 3.75L1.875 3.75Q1.62109 3.75 1.43555 3.9355Q1.25 4.1211 1.25 4.375L1.25 15.625Q1.25 15.87891 1.43555 16.06445Q1.62109 16.25 1.875 16.25L16.875 16.25Q17.1289 16.25 17.3145 16.06445Q17.5 15.87891 17.5 15.625L17.5 4.375Z" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="SearchNavigationItem" Content="Search" Tag="Search" SelectsOnInvoked="False">
          <NavigationViewItem.Icon><FontIcon FontFamily="ms-appx:///Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE721;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="HistoryNavigationItem" Content="History" Tag="History" SelectsOnInvoked="False">
          <NavigationViewItem.Icon><FontIcon FontFamily="ms-appx:///Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE81C;" /></NavigationViewItem.Icon>
          <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="HistoryFlyout" Placement="Right" Opened="HistoryFlyout_Opened" Closed="HistoryFlyout_Closed">
              <StackPanel MinWidth="200">
                <TextBlock x:Name="HistoryEmptyText" Text="No history yet" Opacity="0.6" Margin="12" />
                <ListView x:Name="HistoryList" DisplayMemberPath="DisplayText" IsItemClickEnabled="True" ItemClick="HistoryList_ItemClick" />
              </StackPanel>
            </Flyout>
          </FlyoutBase.AttachedFlyout>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="StreakNavigationItem" Content="Streak" Tag="Streak">
          <!-- Outline of the UWP app's Segoe UI Symbol U+1F525 glyph, preserved for browsers without that system font. -->
          <NavigationViewItem.Icon>
            <PathIcon x:Name="StreakIcon" Data="M12.7201 7.4906Q13.0289 8.8453 13.0289 10.3196Q13.0289 10.9770 12.9691 11.6145Q12.9392 12.6106 12.6903 13.5320Q12.4412 14.4533 12.0129 15.2502Q11.5846 16.0471 10.9969 16.6995Q10.4092 17.3520 9.7019 17.8152Q8.9947 18.2783 8.1829 18.5323Q7.3711 18.7864 6.4945 18.7864Q5.1498 18.7864 3.9694 18.2036Q2.7891 17.6209 1.9075 16.6049Q1.0260 15.5889 0.5130 14.2292Q0.0000 12.8696 0.0000 11.3156L0.0299 11.3156Q0.0498 10.6283 0.2191 9.8066Q0.3885 8.9848 0.8168 8.0186Q1.0459 7.5006 1.1654 7.0076Q1.2850 6.5145 1.2850 5.9965Q1.2850 5.2693 1.0509 4.4675Q0.8168 3.6656 0.3486 2.6695Q1.4842 3.0879 2.1914 3.7652Q2.8986 4.4426 3.3568 5.2893Q3.6357 4.8908 3.8848 4.4376Q4.1338 3.9844 4.3181 3.4615Q4.5023 2.9385 4.6069 2.3259Q4.7115 1.7133 4.7115 0.9961Q4.7115 0.7570 4.6966 0.5080Q4.6816 0.2590 4.6617 0.0000Q5.3291 0.1494 6.0314 0.5429Q6.7335 0.9364 7.4159 1.5539Q8.0982 2.1715 8.7308 2.9883Q9.3633 3.8051 9.8862 4.7912Q10.4092 5.7774 10.8027 6.9229Q11.1960 8.0684 11.3953 9.3334Q11.8236 8.9250 12.1723 8.4768Q12.5209 8.0285 12.7201 7.4906Z" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Verse of the Day" Tag="VerseOfTheDay" SelectsOnInvoked="False">
          <NavigationViewItem.Icon><FontIcon FontFamily="ms-appx:///Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE787;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Grid>
      <Grid x:Name="ReaderLayout">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SearchPanel" Grid.Column="0" Width="320" Visibility="Collapsed"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="#484848" BorderThickness="0,0,1,0" Padding="18,20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Search" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="&#xE711;" FontFamily="ms-appx:///Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" FontSize="12" Padding="8,6" Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0" AutomationProperties.Name="Close search" Click="CloseSearchPanelButton_Click" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="SearchBox" AutomationProperties.Name="Search the Bible" PlaceholderText="Search the Bible..." FontSize="14" KeyDown="SearchBox_KeyDown" />
              <Button Grid.Column="1" Content="&#xE721;" FontFamily="ms-appx:///Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" FontSize="16" Margin="4,0,0,0" Padding="10,4" Background="#333333" Foreground="{ThemeResource TextFillColorPrimaryBrush}" AutomationProperties.Name="Search" Click="SearchButton_Click" />
            </Grid>
            <ComboBox x:Name="SearchScopeComboBox" AutomationProperties.Name="Search scope" Grid.Row="2" SelectedIndex="0" Margin="0,0,0,8" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Entire Bible" /><ComboBoxItem Content="Old Testament" /><ComboBoxItem Content="New Testament" />
            </ComboBox>
            <Grid Grid.Row="3"><TextBlock x:Name="SearchEmptyText" Text="No results" Visibility="Collapsed" Margin="0,12" Opacity="0.7" /><ListView x:Name="SearchResultsListView" IsItemClickEnabled="True" ItemClick="SearchResultsListView_ItemClick" SelectionMode="Single" Background="Transparent">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4,0,4" Spacing="2">
                    <TextBlock Text="{Binding ReferenceText}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding VerseText}" FontSize="12" TextWrapping="Wrap" Opacity="0.76" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView></Grid>
          </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
          <ScrollViewer x:Name="ReaderScrollViewer" ViewChanged="ReaderScrollViewer_ViewChanged" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="22,0,22,20">
              <StackPanel MaxWidth="700" HorizontalAlignment="Center">
                <TextBlock x:Name="BookHeading" Visibility="Collapsed" Text="Genesis" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,68,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="ChapterHeading" Visibility="Collapsed" Text="Chapter 1" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,24,0,8" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <ItemsControl x:Name="VerseList" Margin="0,68,0,24">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Background="{Binding HighlightBrush}">
                        <Grid Visibility="{Binding VerseVisibility}" Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Number}" Visibility="{Binding NumberVisibility}" FontSize="{Binding NumberSize}" Margin="0,4,6,0" VerticalAlignment="Top" Opacity="0.72" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                          <TextBlock Grid.Column="1" IsTextSelectionEnabled="True" Text="{Binding Text}" FontSize="{Binding BodySize}" FontFamily="{Binding ReaderFont}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding Text}" Visibility="{Binding HeadingVisibility}" FontSize="{Binding HeadingSize}" FontFamily="{Binding HeadingFont}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="{Binding HeadingMargin}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Text}" FontSize="{Binding BodySize}" FontFamily="{Binding ReaderFont}" Visibility="{Binding PoetryVisibility}" Margin="20,0,0,6" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Text}" FontSize="{Binding BodySize}" FontFamily="{Binding ReaderFont}" Visibility="{Binding TextVisibility}" Margin="0,0,0,6" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Text}" Visibility="{Binding FootnoteVisibility}" Margin="0,4,0,0" Opacity="0.75" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Border Visibility="{Binding ParagraphVisibility}" Height="8" Background="Transparent" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <!-- Top fade and floating selectors follow the native reader's overlay. -->
          <Border VerticalAlignment="Top" Height="78" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{ThemeResource ReaderSurfaceColor}" Offset="0" />
                <GradientStop Color="{ThemeResource ReaderSurfaceColor}" Offset="0.55" />
                <GradientStop Color="{ThemeResource ReaderTransparentColor}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" Padding="6" CornerRadius="6" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <ComboBox x:Name="BibleBookComboBox" AutomationProperties.Name="Book" Width="200" FontSize="12" DisplayMemberPath="Title" SelectionChanged="BibleBookComboBox_SelectionChanged" DropDownClosed="BibleBookComboBox_DropDownClosed">

              </ComboBox>
              <ComboBox x:Name="BookChapterComboBox" AutomationProperties.Name="Chapter" Width="100" FontSize="12" PlaceholderText="Chapter" SelectionChanged="BookChapterComboBox_SelectionChanged" DropDownClosed="BookChapterComboBox_DropDownClosed" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <StackPanel x:Name="NavigationLoading" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
        <ProgressRing IsActive="True" Width="36" Height="36" AutomationProperties.Name="Loading passage" />
        <TextBlock Text="Loading passage…" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <InfoBar x:Name="NavigationError" IsOpen="False" Severity="Error" Title="Unable to open passage" VerticalAlignment="Bottom" Margin="16">
        <InfoBar.ActionButton><Button Content="Retry" Click="RetryNavigation_Click" /></InfoBar.ActionButton>
      </InfoBar>
      <ContentControl x:Name="SecondaryContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
      </Grid>
    </NavigationView>
  </Grid>
</Page>
