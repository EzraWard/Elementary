<Page x:Class="Elementary.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Dark"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="ReaderSurfaceColor">#F3F3F3</Color>
          <Color x:Key="ReaderTransparentColor">#00F3F3F3</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="ReaderSurfaceColor">#202020</Color>
          <Color x:Key="ReaderTransparentColor">#00202020</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Page.Resources>
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The compact title strip mirrors the native app's Windows title bar. -->
    <Grid Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/TitleBarIcon.png" Width="16" Height="16" />
        <TextBlock Text="Elementary" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <NavigationView x:Name="MainNavigationView" Grid.Row="1" IsPaneOpen="False" PaneDisplayMode="LeftCompact"
                    CompactPaneLength="48" OpenPaneLength="260" IsBackButtonVisible="Collapsed"
                    IsTitleBarAutoPaddingEnabled="False" ItemInvoked="NavigationView_ItemInvoked">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="BibleNavigationItem" Content="Bible" Tag="Bible">
          <NavigationViewItem.Icon><FontIcon FontFamily="ms-appx:///Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE736;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="SearchNavigationItem" Content="Search" Tag="Search" SelectsOnInvoked="False">
          <NavigationViewItem.Icon><FontIcon FontFamily="ms-appx:///Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE721;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="HistoryNavigationItem" Content="History" Tag="History" SelectsOnInvoked="False">
          <NavigationViewItem.Icon><FontIcon FontFamily="ms-appx:///Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE81C;" /></NavigationViewItem.Icon>
          <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="HistoryFlyout" Placement="Right" Opened="HistoryFlyout_Opened" Closed="HistoryFlyout_Closed">
              <StackPanel MinWidth="200">
                <TextBlock x:Name="HistoryEmptyText" Text="No history yet" Opacity="0.6" Margin="12" />
                <ListView x:Name="HistoryList" DisplayMemberPath="DisplayText" IsItemClickEnabled="True" ItemClick="HistoryList_ItemClick" />
              </StackPanel>
            </Flyout>
          </FlyoutBase.AttachedFlyout>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="StreakNavigationItem" Content="Streak" Tag="Streak">
          <!-- Outline of the UWP app's Segoe UI Symbol U+1F525 glyph, preserved for browsers without that system font. -->
          <NavigationViewItem.Icon>
            <PathIcon x:Name="StreakIcon" Data="M12.7201 7.4906Q13.0289 8.8453 13.0289 10.3196Q13.0289 10.9770 12.9691 11.6145Q12.9392 12.6106 12.6903 13.5320Q12.4412 14.4533 12.0129 15.2502Q11.5846 16.0471 10.9969 16.6995Q10.4092 17.3520 9.7019 17.8152Q8.9947 18.2783 8.1829 18.5323Q7.3711 18.7864 6.4945 18.7864Q5.1498 18.7864 3.9694 18.2036Q2.7891 17.6209 1.9075 16.6049Q1.0260 15.5889 0.5130 14.2292Q0.0000 12.8696 0.0000 11.3156L0.0299 11.3156Q0.0498 10.6283 0.2191 9.8066Q0.3885 8.9848 0.8168 8.0186Q1.0459 7.5006 1.1654 7.0076Q1.2850 6.5145 1.2850 5.9965Q1.2850 5.2693 1.0509 4.4675Q0.8168 3.6656 0.3486 2.6695Q1.4842 3.0879 2.1914 3.7652Q2.8986 4.4426 3.3568 5.2893Q3.6357 4.8908 3.8848 4.4376Q4.1338 3.9844 4.3181 3.4615Q4.5023 2.9385 4.6069 2.3259Q4.7115 1.7133 4.7115 0.9961Q4.7115 0.7570 4.6966 0.5080Q4.6816 0.2590 4.6617 0.0000Q5.3291 0.1494 6.0314 0.5429Q6.7335 0.9364 7.4159 1.5539Q8.0982 2.1715 8.7308 2.9883Q9.3633 3.8051 9.8862 4.7912Q10.4092 5.7774 10.8027 6.9229Q11.1960 8.0684 11.3953 9.3334Q11.8236 8.9250 12.1723 8.4768Q12.5209 8.0285 12.7201 7.4906Z" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Verse of the Day" Tag="VerseOfTheDay" SelectsOnInvoked="False">
          <NavigationViewItem.Icon><FontIcon FontFamily="ms-appx:///Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE787;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Grid>
      <Grid x:Name="ReaderLayout">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SearchPanel" Grid.Column="0" Width="320" Visibility="Collapsed"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="#484848" BorderThickness="0,0,1,0" Padding="18,20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Search" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="8,6" Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0" Click="CloseSearchPanelButton_Click" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="SearchBox" PlaceholderText="Search the Bible..." FontSize="14" KeyDown="SearchBox_KeyDown" />
              <Button Grid.Column="1" Content="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="4,0,0,0" Padding="10,4" Background="#333333" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Click="SearchButton_Click" />
            </Grid>
            <ComboBox Grid.Row="2" SelectedIndex="0" Margin="0,0,0,8" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Genesis · KJV preview" />
            </ComboBox>
            <Grid Grid.Row="3"><TextBlock x:Name="SearchEmptyText" Text="No results" Visibility="Collapsed" Margin="0,12" Opacity="0.7" /><ListView x:Name="SearchResultsListView" IsItemClickEnabled="True" ItemClick="SearchResultsListView_ItemClick" SelectionMode="Single" Background="Transparent">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4,0,4" Spacing="2">
                    <TextBlock Text="{Binding ReferenceText}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding VerseText}" FontSize="12" TextWrapping="Wrap" Opacity="0.76" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView></Grid>
          </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
          <ScrollViewer x:Name="ReaderScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="22,0,22,20">
              <StackPanel MaxWidth="700" HorizontalAlignment="Center">
                <TextBlock x:Name="BookHeading" Text="Genesis" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,68,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="ChapterHeading" Text="Chapter 1" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,24,0,8" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <ItemsControl x:Name="VerseList" Margin="0,0,0,24">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <Grid Visibility="{Binding VerseVisibility}" Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Number}" Visibility="{Binding NumberVisibility}" FontSize="{Binding NumberSize}" Margin="0,4,6,0" VerticalAlignment="Top" Opacity="0.72" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="{Binding BodySize}" FontFamily="{Binding ReaderFont}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding Text}" Visibility="{Binding HeadingVisibility}" FontSize="{Binding HeadingSize}" FontFamily="{Binding ReaderFont}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,8" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Text}" FontSize="{Binding BodySize}" FontFamily="{Binding ReaderFont}" Visibility="{Binding PoetryVisibility}" Margin="20,0,0,6" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Text}" FontSize="{Binding BodySize}" FontFamily="{Binding ReaderFont}" Visibility="{Binding TextVisibility}" Margin="0,0,0,6" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Text}" Visibility="{Binding FootnoteVisibility}" Margin="0,4,0,0" Opacity="0.75" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Border Visibility="{Binding ParagraphVisibility}" Height="8" Background="Transparent" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <!-- Top fade and floating selectors follow the native reader's overlay. -->
          <Border VerticalAlignment="Top" Height="78" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{ThemeResource ReaderSurfaceColor}" Offset="0" />
                <GradientStop Color="{ThemeResource ReaderSurfaceColor}" Offset="0.55" />
                <GradientStop Color="{ThemeResource ReaderTransparentColor}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" Padding="6" CornerRadius="6" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <ComboBox x:Name="BibleBookComboBox" Width="200" FontSize="12" SelectedIndex="0" SelectionChanged="BibleBookComboBox_SelectionChanged">
                <ComboBoxItem Content="Genesis" />
              </ComboBox>
              <ComboBox x:Name="BookChapterComboBox" Width="100" FontSize="12" PlaceholderText="Chapter" SelectionChanged="BookChapterComboBox_SelectionChanged" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <ContentControl x:Name="SecondaryContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
      </Grid>
    </NavigationView>
  </Grid>
</Page>
