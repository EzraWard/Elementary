<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <WasmShellIndexHtmlPath>Platforms\WebAssembly\index.html</WasmShellIndexHtmlPath>
    <DefineConstants>$(DefineConstants);UNO_SKIA3</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UnoIconBackgroundFile>Assets\Icons\appicon.png</UnoIconBackgroundFile>
    <UnoIconForegroundFile>Assets\Icons\unused.svg</UnoIconForegroundFile>
    <UnoSplashScreenFile>Assets\Splash\elementary.png</UnoSplashScreenFile>
    <UnoSplashScreenBaseSize>128,128</UnoSplashScreenBaseSize>
    <UnoSplashScreenColor>#202020</UnoSplashScreenColor>

    <!-- Display name -->
    <ApplicationTitle>Elementary Bible</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.grantstreetdesign.elementary</ApplicationId>
    <!-- Versions -->
    <!-- UWP's package manifest is the canonical product version for both apps. -->
    <ElementaryPackageVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../Elementary.UWP/Package.appxmanifest')), '(?&lt;=Version=&quot;)[0-9.]+').Value)</ElementaryPackageVersion>
    <ApplicationDisplayVersion>$([System.Version]::Parse('$(ElementaryPackageVersion)').ToString(3))</ApplicationDisplayVersion>
    <Version>$(ApplicationDisplayVersion)</Version>
    <AssemblyVersion>$(ElementaryPackageVersion)</AssemblyVersion>
    <FileVersion>$(ElementaryPackageVersion)</FileVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Elementary.Uno</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Elementary.Uno powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Hosting;
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <EmbeddedResource Include="Platforms\WebAssembly\WasmCSS\SafeArea.css" />
    <ProjectReference Include="..\..\Elementary.Core\Elementary.Core.csproj" />
    <UnoIcon Include="Assets\Icons\appicon.png" />
    <Content Include="..\..\Elementary.UWP\Assets\TitleBarIcon.scale-*.png" Link="Assets\%(Filename)%(Extension)" />
    <Content Include="..\..\Elementary.UWP\Assets\Fonts\Segoe Fluent Icons.ttf" Link="Assets\Fonts\Segoe Fluent Icons.ttf" />
    <Content Include="..\..\Elementary.UWP\Assets\Square44x44Logo.targetsize-256.png" Link="Assets\Elementary.png" />
    <Content Include="..\..\Elementary.UWP\Assets\StoreLogo.scale-*.png" Link="Assets\%(Filename)%(Extension)" />
    <Content Include="..\..\Elementary.UWP\Assets\Square44x44Logo.targetsize-16.png" Link="Assets\favicon-16.png" />
    <Content Include="..\..\Elementary.UWP\Assets\Square44x44Logo.targetsize-32.png" Link="Assets\favicon-32.png" />
    <Content Include="..\..\Elementary.UWP\Assets\Square44x44Logo.targetsize-48.png" Link="Assets\favicon-48.png" />
    <!-- Reuse the same verse source and artwork implementation without introducing a second Skia runtime. -->
    <Compile Include="..\..\Elementary.VerseOfTheDay\Models\*.cs" Link="Shared\Votd\%(Filename)%(Extension)" />
    <Compile Include="..\..\Elementary.VerseOfTheDay\Interfaces\IVerseFetchService.cs" Link="Shared\Votd\IVerseFetchService.cs" />
    <Compile Include="..\..\Elementary.VerseOfTheDay\Interfaces\IVotdImageCompositor.cs" Link="Shared\Votd\IVotdImageCompositor.cs" />
    <Compile Include="..\..\Elementary.VerseOfTheDay\Services\VerseFetchService.cs" Link="Shared\Votd\VerseFetchService.cs" />
    <Compile Include="..\..\Elementary.VerseOfTheDay\Services\VotdImageCompositor.cs" Link="Shared\Votd\VotdImageCompositor.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(TargetFramework)' == 'net10.0-browserwasm'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Platforms\WebAssembly\WasmCSS\Splash.css" />

  </ItemGroup>

  <PropertyGroup>
    <PreparedScriptureDirectory>$(MSBuildProjectDirectory)\obj\Scripture</PreparedScriptureDirectory>
    <ScriptureCompilerProject>$(MSBuildProjectDirectory)\..\..\..\tools\Elementary.ScriptureCompiler\Elementary.ScriptureCompiler.csproj</ScriptureCompilerProject>
  </PropertyGroup>
  <ItemGroup>
    <ScriptureInputs Include="..\..\Elementary.UWP\Content\**\*.usfm;..\..\Elementary.Core\Parsers\UsfmParser.cs;..\..\Elementary.Core\Models\Bible.cs;..\..\Elementary.Core\Dictionaries\EBookToEPubLocationNET.cs;..\..\..\tools\Elementary.ScriptureCompiler\*.cs;$(ScriptureCompilerProject)" />
  </ItemGroup>
  <Target Name="PrepareScripture" BeforeTargets="AssignTargetPaths" Inputs="@(ScriptureInputs)" Outputs="$(PreparedScriptureDirectory)\complete.stamp" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(ScriptureCompilerProject)&quot; --configuration Release -- &quot;$(MSBuildProjectDirectory)\..\..\Elementary.UWP\Content&quot; &quot;$(PreparedScriptureDirectory)&quot;" />
  </Target>
  <Target Name="IncludePreparedScripture" BeforeTargets="AssignTargetPaths" DependsOnTargets="PrepareScripture">
    <ItemGroup><PreparedBible Include="$(PreparedScriptureDirectory)\*.bible" /><EmbeddedResource Include="@(PreparedBible)" WithCulture="false" LogicalName="Elementary.Uno.Scripture.%(PreparedBible.Filename)%(PreparedBible.Extension)" /></ItemGroup>
  </Target>
</Project>
