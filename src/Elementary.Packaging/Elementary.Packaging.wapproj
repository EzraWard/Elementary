<Project DefaultTargets="Build">
  <PropertyGroup>
    <AppProject>$(MSBuildThisFileDirectory)..\Elementary.UWP\Elementary.UWP.csproj</AppProject>
    <AppProperties>ElementaryPackagingProject=true;GenerateAppxPackageOnBuild=true;ArtifactsPath=$(MSBuildThisFileDirectory)artifacts</AppProperties>
  </PropertyGroup>

  <Target Name="Restore">
    <MSBuild Projects="$(AppProject)" Targets="Restore" Properties="$(AppProperties)" />
  </Target>

  <Target Name="Build">
    <MSBuild Projects="$(AppProject)" Targets="Build" Properties="$(AppProperties)" />
  </Target>

  <Target Name="Publish">
    <MSBuild Projects="$(AppProject)" Targets="Publish" Properties="$(AppProperties)" />
  </Target>
</Project>
