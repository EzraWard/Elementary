<Page
    x:Name="BiblePageRoot"
    x:Class="Elementary.BiblePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Elementary"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:viewmodels="using:Elementary.ViewModels"
    xmlns:converters="using:Elementary.UWP.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewmodels:BiblePageViewModel, IsDesignTimeCreatable=True}"
    Background="Transparent"
    Tag="BiblePage">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" IsInverted="True" />
    </Page.Resources>

    <Grid Width="Auto" Margin="22,0,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="BibleScrollViewer" Grid.RowSpan="2" VerticalScrollBarVisibility="Hidden" ViewChanged="BibleScrollViewer_ViewChanged">
            <StackPanel x:Name="ChaptersContainer">
				<muxc:ItemsRepeater x:Name="ChaptersRepeater" ItemsSource="{Binding Chapters}">
					<muxc:ItemsRepeater.ItemTemplate>
						<DataTemplate>
                            <Grid x:Name="ChapterItemGrid" Margin="0,0,0,20">
                                <StackPanel MaxWidth="700"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Index}" FontSize="26" FontWeight="Bold" Margin="0,24,0,8"/>
                                    <muxc:ItemsRepeater ItemsSource="{Binding DisplayLines}">
                                        <muxc:ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Loaded="DisplayLineContainer_Loaded">
                                                    <Grid Visibility="{Binding IsVerse, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding VerseNumberText}" Tag="versenum" Margin="0,-4,6,0" VerticalAlignment="Top" Opacity="0.8"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Text}"
                                                                   Tag="body"
                                                                   TextWrapping="WrapWholeWords"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Text}" Tag="heading" Visibility="{Binding IsHeading, Converter={StaticResource BoolToVisibilityConverter}}" FontWeight="SemiBold" Margin="0,10,0,6" TextWrapping="WrapWholeWords"/>
                                                    <TextBlock Text="{Binding Text}" Tag="body" Visibility="{Binding IsPoetry, Converter={StaticResource BoolToVisibilityConverter}}" Margin="20,0,0,6" TextWrapping="WrapWholeWords"/>
                                                    <TextBlock Text="{Binding Text}" Tag="body" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,6" TextWrapping="WrapWholeWords"/>
                                                    <TextBlock Text="{Binding Text}" Tag="footnote" Visibility="{Binding IsFootnote, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,0" Opacity="0.75" TextWrapping="WrapWholeWords"/>
                                                    <Border Visibility="{Binding IsParagraphBreak, Converter={StaticResource BoolToVisibilityConverter}}" Height="8" Background="Transparent"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </muxc:ItemsRepeater.ItemTemplate>
                                    </muxc:ItemsRepeater>
                                </StackPanel>
                            </Grid>
						</DataTemplate>
					</muxc:ItemsRepeater.ItemTemplate>
				</muxc:ItemsRepeater>
			</StackPanel>
        </ScrollViewer>
		<Border x:Name="ChooserBorder" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" Padding="6" CornerRadius="6" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibilityConverter}}" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
				<ComboBox x:Name="BibleBookComboBox"
                          Width="200"
                          FontSize="12"
                          ItemsSource="{Binding Bible.Books}"
                          DisplayMemberPath="Title"
                          SelectedItem="{Binding CurrentBook, Mode=TwoWay}"
                          PlaceholderText="Bible" 
                          Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                          SelectionChanged="BibleBookChapterComboBoxes_SelectionChanged"/>

				<ComboBox x:Name="BookChapterComboBox" 
                          Width="100"
                          FontSize="12"
                          ItemsSource="{Binding ChapterIndices}" 
                          SelectedItem="{Binding SelectedChapterIndex, Mode=TwoWay}"
                          PlaceholderText="Chapter" 
                          Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                          SelectionChanged="BibleBookChapterComboBoxes_SelectionChanged"/>
			</StackPanel>
		</Border>

		<Grid Grid.RowSpan="2">
            <muxc:ProgressRing x:Name="BiblePageProgressRing"  IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" Height="75" Width="75" Visibility="{Binding IsLoaded, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Page>
