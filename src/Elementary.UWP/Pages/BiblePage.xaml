<Page
    x:Class="Elementary.BiblePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Elementary"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:viewmodels="using:Elementary.ViewModels"
    xmlns:common="using:html2xaml"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewmodels:BiblePageViewModel, IsDesignTimeCreatable=True}"
    Background="Transparent"
    Tag="BiblePage">

    <Grid Width="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="8,8,8,8">
            <ComboBox x:Name="BibleBookComboBox"
                      ItemsSource="{Binding Bible.Books}"
                      DisplayMemberPath="Title"
                      SelectedItem="{Binding CurrentBook, Mode=TwoWay}"
                      PlaceholderText="Bible" />

            <ComboBox x:Name="BookChapterComboBox" 
                      ItemsSource="{Binding ChapterIndices}" 
                      SelectedItem="{Binding SelectedChapterIndex, Mode=TwoWay}"
                      PlaceholderText="Chapter"/>
        </StackPanel>
        <ScrollViewer x:Name="BibleScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="RichTextGrid" SizeChanged="WebViewGrid_SizeChanged">
                <RichTextBlock x:Name="ChapterView" common:Properties.Html="{Binding CurrentChapter.ChapterText}" FontFamily="{Binding AppSettings.Font}" FontSize="{Binding FontSize}" />
            </Grid>
        </ScrollViewer>
        <Grid Grid.RowSpan="2">
            <muxc:ProgressRing IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>