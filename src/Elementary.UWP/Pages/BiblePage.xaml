<Page
    x:Class="Elementary.BiblePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Elementary"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:viewmodels="using:Elementary.ViewModels"
    xmlns:converters="using:Elementary.UWP.Converters"
    xmlns:common="using:html2xaml"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewmodels:BiblePageViewModel, IsDesignTimeCreatable=True}"
    Background="Transparent"
    Tag="BiblePage">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" IsInverted="True" />
    </Page.Resources>

    <Grid Width="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="BibleScrollViewer" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" ViewChanged="BibleScrollViewer_ViewChanged">
            <StackPanel x:Name="ChaptersContainer">
				<muxc:ItemsRepeater x:Name="ChaptersRepeater" ItemsSource="{Binding Chapters}">
					<muxc:ItemsRepeater.ItemTemplate>
						<DataTemplate>
							<Grid x:Name="ChapterItemGrid" SizeChanged="ChapterItemGrid_SizeChanged">
								<RichTextBlock x:Name="ChapterRichTextBlock" 
                                             common:Properties.Html="{Binding ChapterText}" />
							</Grid>
						</DataTemplate>
					</muxc:ItemsRepeater.ItemTemplate>
				</muxc:ItemsRepeater>
			</StackPanel>
        </ScrollViewer>
		<Border Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" Padding="6" CornerRadius="6" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
				<ComboBox x:Name="BibleBookComboBox"
                          Width="200"
                          FontSize="12"
                          ItemsSource="{Binding Bible.Books}"
                          DisplayMemberPath="Title"
                          SelectedItem="{Binding CurrentBook, Mode=TwoWay}"
                          PlaceholderText="Bible" 
                          Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                          SelectionChanged="BibleBookChapterComboBoxes_SelectionChanged"/>

				<ComboBox x:Name="BookChapterComboBox" 
                          Width="100"
                          FontSize="12"
                          ItemsSource="{Binding ChapterIndices}" 
                          SelectedItem="{Binding SelectedChapterIndex, Mode=TwoWay}"
                          PlaceholderText="Chapter" 
                          Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                          SelectionChanged="BibleBookChapterComboBoxes_SelectionChanged"/>
			</StackPanel>
		</Border>

		<Grid Grid.RowSpan="2">
            <muxc:ProgressRing x:Name="BiblePageProgressRing"  IsActive="True" HorizontalAlignment="Center" VerticalAlignment="Center" Height="75" Width="75" Visibility="{Binding IsLoaded, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Page>