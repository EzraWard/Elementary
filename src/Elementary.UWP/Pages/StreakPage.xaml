<Page
    x:Class="Elementary.StreakPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Elementary.ViewModels"
    xmlns:converters="using:Elementary.UWP.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" IsInverted="True" />
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="VeryNarrowLayout" />
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="500" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentStackPanel.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentStackPanel.Margin" Value="0" />
                        <Setter Target="CardsPrimaryColumn.Width" Value="320" />
                        <Setter Target="CardsSecondaryColumn.Width" Value="*" />
                        <Setter Target="StreakDetailsCard.(Grid.Column)" Value="1" />
                        <Setter Target="StreakDetailsCard.(Grid.Row)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer>
            <Grid Padding="16">
                <StackPanel x:Name="ContentStackPanel" MaxWidth="1000" Spacing="16">
                    <TextBlock x:Name="HeaderTextBlock" Text="Reading Streak" FontSize="32" FontWeight="Bold" />
                    <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Opacity="0.8" TextWrapping="WrapWholeWords" />

                    <Grid x:Name="CardsGrid" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CardsPrimaryColumn" Width="*" />
                            <ColumnDefinition x:Name="CardsSecondaryColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="StreakHeroCard"
                                Grid.Column="0"
                                Grid.Row="0"
                                Padding="16"
                                CornerRadius="8"
                                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                            <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                                <TextBlock FontSize="72"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind ViewModel.CurrentStreak, Mode=OneWay}"
                                           TextAlignment="Center">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Offset="1" Color="#FFFCC94E" />
                                            <GradientStop Offset="0" Color="#FFD67606" />
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock Text="{x:Bind ViewModel.StreakLabel, Mode=OneWay}"
                                           TextAlignment="Center"
                                           Opacity="0.85" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.RecentActivity, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:StreakDayActivityViewModel">
                                            <Grid Padding="2,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{x:Bind DayOfWeekShort}"
                                                           FontSize="11"
                                                           Opacity="0.6"
                                                           TextAlignment="Center"
                                                           Margin="0,0,0,6" />
                                                <Ellipse Grid.Row="1"
                                                         Width="18"
                                                         Height="18"
                                                         Fill="#FFD67606"
                                                         Visibility="{x:Bind Active, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Ellipse Grid.Row="1"
                                                         Width="18"
                                                         Height="18"
                                                         Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                                         Opacity="0.25"
                                                         Visibility="{x:Bind Active, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind ViewModel.ThresholdHelpText, Mode=OneWay}"
                                           FontSize="12"
                                           Opacity="0.6"
                                           TextAlignment="Center"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="StreakDetailsCard"
                                Grid.Column="0"
                                Grid.Row="1"
                                Padding="16"
                                CornerRadius="8"
                                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                            <Grid ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Current streak" FontSize="13" Opacity="0.65" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentStreak, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Longest streak" FontSize="13" Opacity="0.65" />
                                    <TextBlock Text="{x:Bind ViewModel.LongestStreak, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                    <TextBlock Text="How it works" FontSize="13" Opacity="0.65" />
                                    <TextBlock Text="{x:Bind ViewModel.HowItWorksText, Mode=OneWay}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
