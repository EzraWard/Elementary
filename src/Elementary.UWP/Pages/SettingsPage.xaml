<Page
    x:Class="Elementary.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Elementary"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d"
    Background="Transparent"
    Tag="Settings">

    <Page.Resources>
        <!--  These styles can be referenced to create a consistent SettingsPage layout  -->

        <!--  Spacing between cards  -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <!--  Style (inc. the correct spacing) of a section header  -->
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <Grid Padding="16">
                <StackPanel MaxWidth="1000"
                        HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}">
                    <!--<win:StackPanel.ChildrenTransitions>
                        <win:EntranceThemeTransition FromVerticalOffset="50" />
                        <win:RepositionThemeTransition IsStaggeringEnabled="False" />
                    </win:StackPanel.ChildrenTransitions>-->
                    

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="Reading" />
                    <controls:SettingsCard Description="The translation of the Bible you would like to use"
                                       Header="Translation">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="/Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE736;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox ItemsSource="{x:Bind ViewModel.TranslationOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTranslation, Mode=TwoWay}"
                                  DisplayMemberPath="Display" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Choose whether to show verse numbers inline"
                                           Header="Show verse numbers">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="/Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE8A4;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <!--<ToggleSwitch IsOn="{x:Bind ViewModel.ShowVerseNumbers, Mode=TwoWay}" />-->
                        <ToggleSwitch IsOn="True" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Select the font for text"
                                           Header="Font">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="/Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE8D2;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox ItemsSource="{x:Bind ViewModel.FontOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFont, Mode=TwoWay}"
                                  DisplayMemberPath="Display" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Select the font size for text"
                                           Header="Font size">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="/Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE8E9;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox ItemsSource="{x:Bind ViewModel.FontSizeOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFontSize, Mode=TwoWay}"
                                  DisplayMemberPath="Display" />
                    </controls:SettingsCard>

                    <!--General-->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="General" />
                    <controls:SettingsCard Description="Set the color scheme you prefer"
                                           Header="Theme">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="/Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE790;"/>
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                                  DisplayMemberPath="Display" />
                    </controls:SettingsCard>

                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Acknowledgements" />
                    <controls:SettingsExpander Description="Acknowledgement for the NET Bible"
                                               Header="NET Bible">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon FontFamily="/Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons" Glyph="&#xE716;"/>
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="Scripture quoted by permission. Quotations designated (NET) are from the NET Bible® copyright ©1996, 2019 by Biblical Studies Press, L.L.C. http://netbible.com All rights reserved."/>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!--About-->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="About" />

                    <controls:SettingsExpander Description="© 2026. All rights reserved."
                                           Header="Elementary"
                                           HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/StoreLogo.scale-400.png}">
                        <TextBlock Text="{x:Bind ViewModel.ApplicationVersion}"
                                   win:IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <TextBlock Text="👨🏻‍👩🏻‍👧🏻‍👦🏻 Hello from Williamstown" />
                                </controls:SettingsCard.Header>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <HyperlinkButton Margin="0,0,0,0"
                                 Content="Send feedback" NavigateUri="mailto:ezra.ward@outlook.com"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
