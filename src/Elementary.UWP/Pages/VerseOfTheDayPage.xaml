<Page
    x:Class="Elementary.VerseOfTheDayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid>
        <!-- Loading state -->
        <muxc:ProgressRing x:Name="LoadingRing"
                           IsActive="True"
                           Width="48" Height="48"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Grid.Row="0" />

        <!-- Error state -->
        <StackPanel x:Name="ErrorPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Grid.Row="0">
            <TextBlock Text="Unable to load Verse of the Day."
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center" />
            <Button x:Name="RefreshButton"
                    Content="Retry"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Click="RefreshButton_Click" />
        </StackPanel>

        <!-- Border backgrounds are clipped by CornerRadius. -->
        <Viewbox x:Name="VerseImageContainer"
                 Visibility="Collapsed"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Grid.Row="0">
            <Border Width="800"
                    Height="800"
                    CornerRadius="16">
                <Border.Background>
                    <ImageBrush x:Name="VerseImageBrush"
                                Stretch="Uniform" />
                </Border.Background>
            </Border>
        </Viewbox>

    </Grid>
</Page>
