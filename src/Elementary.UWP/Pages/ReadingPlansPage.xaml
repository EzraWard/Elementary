<Page
    x:Class="Elementary.ReadingPlansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Elementary.UWP.Converters"
    xmlns:models="using:Elementary.Core.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" IsInverted="True" />
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <Grid Padding="16">
                <StackPanel MaxWidth="1000" Spacing="16">
                    <TextBlock Text="Reading Plans" FontSize="32" FontWeight="Bold" />
                    <TextBlock Text="{x:Bind ViewModel.ActivePlanSummary, Mode=OneWay}" Opacity="0.8" TextWrapping="WrapWholeWords" />

                    <TextBlock Text="Built-in plans" FontSize="18" FontWeight="SemiBold" />
                    <ListView x:Name="PlansListView"
                              ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}"
                              SelectionMode="Single"
                              SelectionChanged="PlansListView_SelectionChanged"
                              MaxHeight="280">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ReadingPlan">
                                <StackPanel Margin="0,8,0,8">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="WrapWholeWords" Opacity="0.75" Margin="0,2,0,0" />
                                    <TextBlock Text="{x:Bind TotalDaysText}" Opacity="0.6" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Padding="16"
                            CornerRadius="8"
                            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.SelectedPlanTitle, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedPlanDescription, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedPlanMeta, Mode=OneWay}" Opacity="0.7" />
                            <TextBlock Text="{x:Bind ViewModel.ProgressSummary, Mode=OneWay}" Opacity="0.8" TextWrapping="WrapWholeWords" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{x:Bind ViewModel.StartButtonText, Mode=OneWay}"
                                        Click="StartOrRestartPlanButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanStartSelectedPlan, Mode=OneWay}" />
                                <Button Content="Mark current reading complete"
                                        Click="MarkCurrentReadingCompleteButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanCompleteCurrentDay, Mode=OneWay}" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.VisibleDayHeading, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.VisibleDayDescription, Mode=OneWay}" Opacity="0.75" TextWrapping="WrapWholeWords" />

                            <TextBlock Text="No passages available."
                                       Visibility="{x:Bind ViewModel.HasVisibleDay, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                       Opacity="0.6" />

                            <ListView ItemsSource="{x:Bind ViewModel.VisibleDayPassages, Mode=OneWay}"
                                      IsItemClickEnabled="True"
                                      ItemClick="VisibleDayPassagesListView_ItemClick"
                                      Visibility="{x:Bind ViewModel.HasVisibleDay, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ReadingPlanPassage">
                                        <StackPanel Margin="0,6,0,6">
                                            <TextBlock Text="{x:Bind ReferenceText}" FontWeight="SemiBold" />
                                            <TextBlock Text="Open in the Bible reader" Opacity="0.6" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
