<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap mp uap3 com">

  <Identity
    Name="21366BowTieWorkshop.ElementaryBibleDev"
    Publisher="CN=16499A74-7239-425D-8D4D-A75684AF24BE"
    Version="0.7.0.0" />

  <mp:PhoneIdentity PhoneProductId="2667bc56-bc11-4b7e-93bd-249407dd3231" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Elementary Dev</DisplayName>
    <PublisherDisplayName>Grant Street Design</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.0.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="Elementary.App">
      <uap:VisualElements
        DisplayName="Elementary Dev"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Elementary Dev"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo"/>
            <uap:ShowOn Tile="wide310x150Logo"/>
            <uap:ShowOn Tile="square310x310Logo"/>
          </uap:ShowNameOnTiles>
        </uap:DefaultTile >
        <uap:SplashScreen Image="Assets\SplashScreen.png"  BackgroundColor="transparent"/>
      </uap:VisualElements>
      <Extensions>
        <!-- COM server registration: the widget host activates the app as a COM server
             to request widget content. The app detects this via launch arguments. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="$targetnametoken$.exe" Arguments="-WidgetProvider" DisplayName="Elementary Widget Provider">
              <com:Class Id="3d74d74e-b22c-4e5c-9b5a-3e4b8b4f3b9a" DisplayName="Verse of the Day Widget Provider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- Widget provider declaration: registers the Verse of the Day widget with
             the Windows 11 widget board. Supports small, medium, and large sizes. -->
        <uap3:Extension Category="windows.widgetProvider">
          <uap3:WidgetProvider>
            <uap3:WidgetProviderIcons>
              <uap3:Icon Path="Assets\StoreLogo.scale-100.png" />
            </uap3:WidgetProviderIcons>
            <uap3:Activation>
              <uap3:CreateInstance ClassId="3d74d74e-b22c-4e5c-9b5a-3e4b8b4f3b9a" />
            </uap3:Activation>
            <uap3:Definitions>
              <uap3:Definition
                Id="VerseOfTheDayWidget"
                DisplayName="Verse of the Day"
                Description="Shows the daily Bible verse"
                AllowMultiple="false">
                <uap3:Capabilities>
                  <uap3:Capability Type="size" Value="small" />
                  <uap3:Capability Type="size" Value="medium" />
                  <uap3:Capability Type="size" Value="large" />
                </uap3:Capabilities>
              </uap3:Definition>
            </uap3:Definitions>
          </uap3:WidgetProvider>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
