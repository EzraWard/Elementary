<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' != 'AnyCPU'">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <RootNamespace>Elementary</RootNamespace>
    <AssemblyName>Elementary</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <UseUwp>true</UseUwp>
    <EnableMsixTooling>true</EnableMsixTooling>
    <MicrosoftWindowsSDKBuildToolsMSIXPackageVersion>1.7.261119100</MicrosoftWindowsSDKBuildToolsMSIXPackageVersion>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <IncludeDebugSymbolsProjectOutputGroup Condition="'$(PublishAot)' == 'true'">false</IncludeDebugSymbolsProjectOutputGroup>
    <IncludeDebugSymbolsProjectOutputGroup Condition="'PublishAot)' == 'true'">false</IncludeDebugSymbolsProjectOutputGroup>
    <SelfContained>true</SelfContained>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x86|x64|arm64</AppxBundlePlatforms>
    <AppxPackageSigningEnabled Condition="'$(Configuration)' == 'Debug'">false</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile Condition="Exists('Elementary.UWP_TemporaryKey.pfx')">Elementary.UWP_TemporaryKey.pfx</PackageCertificateKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="..\Elementary.Packaging\Package.appxmanifest" Condition="'$(ElementaryPackagingProject)' == 'true'" />
    <AppxManifest Include="Package.Debug.appxmanifest" Condition="'$(ElementaryPackagingProject)' != 'true' and ('$(Configuration)' == 'Debug' or '$(ElementaryDevelopmentPackage)' == 'true')" />
    <AppxManifest Include="Package.appxmanifest" Condition="'$(ElementaryPackagingProject)' != 'true' and '$(Configuration)' != 'Debug' and '$(ElementaryDevelopmentPackage)' != 'true'" />
    <Content Include="Assets\**\*" Exclude="Assets\StoreLogo.backup.png" />
    <Content Include="Content\**\*.usfm" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.Uwp.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" PrivateAssets="all" />
    <PackageReference Include="Win2D.uwp" Version="1.28.3" />
    <ProjectReference Include="..\Elementary.Core\Elementary.Core.csproj" />
    <ProjectReference Include="..\Elementary.VerseOfTheDay\Elementary.VerseOfTheDay.csproj" />
  </ItemGroup>
</Project>
