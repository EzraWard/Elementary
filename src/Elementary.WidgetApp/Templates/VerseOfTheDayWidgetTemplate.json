{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Image",
      "url": "${imageUri}",
      "size": "stretch",
      "altText": "Verse of the Day"
    },
    {
      "type": "TextBlock",
      "text": "${reference}",
      "size": "small",
      "color": "light",
      "isSubtle": true
    }
  ]
}
